# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.

# Обязательный ключ для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Максимальный размер загружаемого фото чека, МБ
MAX_UPLOAD_MB=10

# Необязательно: база данных (по умолчанию локальный SQLite в data/checkai.db)
# Для SQLite:
# DATABASE_URL=sqlite:///data/checkai.db
# Для PostgreSQL (локально или в Docker):
# DATABASE_URL=postgresql://checkai:checkai_secret@localhost:5432/checkai
# DATABASE_URL=postgresql://checkai:checkai_secret@db:5432/checkai

# Необязательно: папка с фото чеков (по умолчанию data/receipts)
# UPLOADS_DIR=data/receipts

# Доверять заголовку X-Forwarded-For — только если сервер стоит за своим прокси (nginx и т.п.)
TRUST_PROXY=0

# Как часто удалять несохранённые фото чеков старше суток, часы (0 — не удалять)
ORPHAN_CLEANUP_HOURS=6

# Docker без контейнера ollama: адрес Ollama, установленной на компьютере.
# Запуск: docker compose up -d --build (без --profile full)
# DOCKER_OLLAMA_HOST=http://host.docker.internal:11434

# Необязательно: папка с фото профиля (по умолчанию data/avatars)
# AVATARS_DIR=data/avatars


# Необязательно: распознавание (значения по умолчанию подобраны на ml/evaluation/benchmark.py)
# OLLAMA_NUM_CTX=8192   # окно контекста Qwen
# OCR_PREPROCESS=1      # 0 — отдавать фото в OCR без предобработки
# OCR_MAX_SIDE=2000     # большие фото уменьшаются до этого размера
# OCR_MIN_WIDTH=0       # увеличивать узкие фото (выключено)
# OCR_CLAHE=0           # выравнивать контраст (выключено)

# ИИ-рекомендации по расходам (NEXT_WEEK_TASKS.md, B.2): gemini | ollama | off
# off — только шаблонные советы, данные никуда не уходят
AI_PROVIDER=gemini
# Ключ из Google AI Studio. Только здесь, в .env на сервере: во фронт и в git не попадает
GEMINI_API_KEY=
# Название модели — актуальное смотреть на ai.google.dev
GEMINI_MODEL=
# Не чаще одного нового анализа на пользователя за столько часов
INSIGHTS_REFRESH_HOURS=6
