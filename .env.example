# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.

# Обязательный ключ для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Максимальный размер загружаемого фото чека, МБ
MAX_UPLOAD_MB=10

# Необязательно: база данных (по умолчанию локальный SQLite в data/checkai.db)
# Для SQLite:
# DATABASE_URL=sqlite:///data/checkai.db
# Для PostgreSQL (локально или в Docker):
# DATABASE_URL=postgresql://checkai:checkai_secret@localhost:5432/checkai
# DATABASE_URL=postgresql://checkai:checkai_secret@db:5432/checkai

# Необязательно: папка с фото чеков (по умолчанию data/receipts)
# UPLOADS_DIR=data/receipts

# Доверять заголовку X-Forwarded-For — только если сервер стоит за своим прокси (nginx и т.п.)
TRUST_PROXY=0

# Как часто удалять несохранённые фото чеков старше суток, часы (0 — не удалять)
ORPHAN_CLEANUP_HOURS=6

# Docker без контейнера ollama: адрес Ollama, установленной на компьютере.
# Запуск: docker compose up -d --build (без --profile full)
# DOCKER_OLLAMA_HOST=http://host.docker.internal:11434
