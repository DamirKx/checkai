# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.

# Обязательный ключ для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Максимальный размер загружаемого фото чека, МБ
MAX_UPLOAD_MB=10

# Необязательно: база данных (по умолчанию локальный SQLite в data/checkai.db)
# Для SQLite:
# DATABASE_URL=sqlite:///data/checkai.db
# Для PostgreSQL (локально или в Docker):
# DATABASE_URL=postgresql://checkai:checkai_secret@localhost:5432/checkai
# DATABASE_URL=postgresql://checkai:checkai_secret@db:5432/checkai

# Необязательно: папка с фото чеков (по умолчанию data/receipts)
# UPLOADS_DIR=data/receipts

# Доверять заголовку X-Forwarded-For — только если сервер стоит за своим прокси (nginx и т.п.)
TRUST_PROXY=0

# Как часто удалять несохранённые фото чеков старше суток, часы (0 — не удалять)
ORPHAN_CLEANUP_HOURS=6

# Docker без контейнера ollama: адрес Ollama, установленной на компьютере.
# Запуск: docker compose up -d --build (без --profile full)
# DOCKER_OLLAMA_HOST=http://host.docker.internal:11434

# Необязательно: папка с фото профиля (по умолчанию data/avatars)
# AVATARS_DIR=data/avatars


# Необязательно: распознавание (значения по умолчанию подобраны на ml/evaluation/benchmark.py)
# OLLAMA_MODEL=qwen2.5:3b           # локальная модель Ollama
# OLLAMA_NUM_CTX=8192               # окно контекста Qwen (обычный чек)
# OLLAMA_NUM_CTX_LONG=16384         # окно контекста Qwen (длинный чек)
# OLLAMA_TIMEOUT=120                # таймаут Qwen для обычного чека, сек
# OLLAMA_LONG_TIMEOUT=180           # таймаут Qwen для длинного чека, сек
# OLLAMA_USE_SCHEMA=1               # 1 — передавать JSON-схему в format Ollama
# OLLAMA_CATEGORIZE_TIMEOUT=30      # базовый таймаут категоризации Qwen, сек
# CATEGORIZE_BATCH_SIZE=30          # размер батча позиций для категоризации Qwen
# CATEGORIZE_FAST_FIRST=0           # 1 — сначала кэш и ключевые слова, Qwen только для незнакомых (на длинных >20 вкл. авто). В Docker по умолчанию 1
# OCR_PREPROCESS=1                  # 0 — отдавать фото в OCR без предобработки
# OCR_TARGET_WIDTH=1200             # целевая ширина фото перед OCR (длина сохраняется для длинных чеков)
# OCR_SLICE_HEIGHT=1600             # высота полосы нарезки длинного фото, px
# OCR_SLICE_OVERLAP=140             # перекрытие соседних полос, px
# OCR_MERGE_LINES=1                 # 1 — склеивать фрагменты одной строки по координатам
# OCR_LONG_LINES_THRESHOLD=80       # порог строк для режима длинного чека
# OCR_LONG_ASPECT_RATIO=3.0         # порог h/w для режима длинного чека
# OCR_FILTER_SERVICE_LINES=1        # 1 — вырезать служебный шум (ОФД/URL/реклама) до LLM
# OCR_ENABLE_MKLDNN=0               # 1 — включить OneDNN/MKL-DNN в PaddleOCR: OCR ~в 5 раз быстрее. В Docker по умолчанию 1
# OCR_CPU_THREADS=0                 # число потоков CPU для PaddleOCR (0 — по умолчанию)
# OCR_MIN_WIDTH=0                   # увеличивать узкие фото (выключено)
# OCR_CLAHE=0                       # выравнивать контраст (выключено)
# OCR_WARMUP=0                      # 1 — загружать модель распознавания при старте сервера (в Docker по умолчанию 1)
# LOG_LEVEL=INFO        # логи приложения: DEBUG | INFO | WARNING | ERROR

# ИИ-рекомендации по расходам (NEXT_WEEK_TASKS.md, B.2): gemini | ollama | off
# off — только шаблонные советы, данные никуда не уходят
AI_PROVIDER=gemini
# Ключ из Google AI Studio. Только здесь, в .env на сервере: во фронт и в git не попадает
GEMINI_API_KEY=
# Название модели — актуальное смотреть на ai.google.dev
GEMINI_MODEL=
# Не чаще одного нового анализа на пользователя за столько минут (0 — без ограничения).
# Старая INSIGHTS_REFRESH_HOURS учитывается, только если эта не задана
INSIGHTS_REFRESH_MINUTES=1
