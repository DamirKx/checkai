# Виртуальное окружение (обязательно исключить, весит несколько гигабайт!)
.venv/
venv/
env/
ENV/

# Байткод Python и кэш
__pycache__/
*.py[cod]
*$py.class
*.so

# Кэш скачанных моделей PaddleOCR / PaddleX
.paddlex/
*.onnx

# Временные файлы загрузок и результатов
*.tmp
temp_*

# Данные приложения (БД, загруженные чеки) — не коммитим!
data/*
!data/.gitkeep
!data/receipts/
data/receipts/*
!data/receipts/.gitkeep
*.db
*.sqlite
*.sqlite3

# Тесты и покрытие
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Логи
*.log

# Секреты (SECRET_KEY и др.). Шаблон — .env.example
.env
.env.*
!.env.example

# Результаты распознавания
*_result.json

# Конфигурации редакторов и ОС
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
